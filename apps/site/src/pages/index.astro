---
import Docs from '../layouts/Docs.astro';
import LandingHero from '../components/LandingHero.astro';
import CardGrid from '../components/CardGrid.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('devToRehype');

---

<Docs title="">
	<LandingHero
		title="DX Lab"
		description="I build tools and plugins that optimize the developer and writer experience. 
		DX Lab is where I open-source my solutions and document my processes. This site is brand new.
		Please check back for updates."
		buttons={[
			{ label: 'Read the blog', href: '/blog', variant: 'primary' },
			{ label: 'View tools', href: '/tools/docs', variant: 'secondary' },
		]}
	/>
	<CardGrid title="Recent Posts">
		{posts.map((post) => (
			<Card
				title={post.data.title}
				description={post.data.description}
				href={`/blog/${post.data.slug}`}
			/>
		))}
	</CardGrid>
</Docs>