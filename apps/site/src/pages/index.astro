---
import Docs from '../layouts/Docs.astro';
import LandingHero from '../components/LandingHero.astro';
import CardGrid from '../components/CardGrid.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('devTo');

---

<Docs title="">
	<LandingHero
		title="Kate Bartolo"
		description="This is my sanctuary for slow code projects and thoughtful design,
		and exploring the space where content strategy meets engineering."
		buttons={[
			{ label: 'Read the blog', href: '/blog', variant: 'primary' },
			{ label: 'View tools', href: '/tools/docs', variant: 'secondary' },
		]}
	/>
	<CardGrid title="Recent Posts">
		{posts.map((post) => (
			<Card
				title={post.data.title}
				description={post.data.description}
				href={`/blog/${post.data.slug}`}
			/>
		))}
	</CardGrid>
</Docs>