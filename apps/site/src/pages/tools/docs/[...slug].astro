---
import { getCollection } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import MDXRenderer from 'astro-mdx-remote/components/MDXRenderer.astro';
import type { MDXContent } from 'mdx/types';
import { mdxParser } from 'astro-mdx-remote';
import { compileMdx } from '../../../utils/mdx';
import { extractHeadings } from '../../../utils/headings';

// Ensure dev.to only fetched at build time (static collection)
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('packageDocs');

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const docs = await getCollection('packageDocs');
const sidebar = [{
  label: 'astro-mdx-remote',
  items: [
    { label: 'Overview', path: '/tools/docs/astro-mdx-remote' },
    ...docs
      .filter((post) => post.data.slug !== 'astro-mdx-remote')
      .map((post) => ({ label: post.data.title, path: `/tools/docs/${post.data.slug}` }))
  ]
}];


const { post } = Astro.props;
const headings = extractHeadings(post.data.markdown);

const { frontmatter, content } = mdxParser(post.data.markdown);

// Get the raw evaluated MDX function component
const MDXContent = await compileMdx(content);

---

<Docs {...post.data} sidebar={sidebar} headings={headings}>
  <MDXRenderer compiledContent={MDXContent} />
</Docs>