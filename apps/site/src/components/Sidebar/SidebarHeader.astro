---
export interface Props {
  logo?: string;
  title?: string;
}

const { logo = '◇', title = 'Documentation' } = Astro.props;
---

<div class="sundrop-sidebar-header">
  <div class="header-brand">
    <span class="brand-logo" aria-hidden="true">{logo}</span>
    <span class="brand-title sidebar-text">{title}</span>
  </div>
  <slot />
</div>

<style>
@layer sundrop-components {
  .sundrop-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sundrop-scale-3) var(--sundrop-scale-4);
    border-bottom: 1px solid var(--sundrop-color-border-default);
    flex-shrink: 0;
    min-height: 3.5rem;
    box-sizing: border-box;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: var(--sundrop-scale-2);
    font-weight: 600;
    font-size: var(--sundrop-size-body);
    color: var(--sundrop-color-fg-default);
  }

  .brand-logo {
    font-size: var(--sundrop-size-h5);
    line-height: 1;
  }
}
</style>