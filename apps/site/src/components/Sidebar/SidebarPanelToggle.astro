<button
  class="sundrop-sidebar-toggle"
  id="sundrop-sidebar-toggle"
  aria-expanded="true"
  aria-controls="sundrop-sidebar-panel"
  aria-label="Toggle sidebar"
>
 <svg
  xmlns="http://www.w3.org/2000/svg"
  width="15"
  height="15"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="3" width="18" height="18" rx="2"/>
  <path d="M9 3v18"/>
</svg>
</button>

<script is:inline>
  (function () {
    const match = document.cookie.match(/sidebar-collapsed=([^;]+)/);
    const collapsed = match?.[1] === 'true';
    const btn = document.getElementById('sundrop-sidebar-toggle');
    if (btn) btn.setAttribute('aria-expanded', String(!collapsed));
  })();
</script>

<script>
  const toggle = document.getElementById('sundrop-sidebar-toggle') as HTMLButtonElement;
  const panel  = document.getElementById('sundrop-sidebar-panel') as HTMLElement;
  const shell  = document.querySelector('.sundrop-shell') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const isCollapsed = panel?.dataset.collapsed === 'true';
    const next = !isCollapsed;

    panel.dataset.collapsed = String(next);
    shell.dataset.sidebarCollapsed = String(next);
    toggle.setAttribute('aria-expanded', String(!next));
    document.cookie = `sidebar-collapsed=${next};path=/;max-age=31536000;SameSite=Lax`;
  });
</script>

<style>
@layer sundrop-components {
  .sundrop-sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    border: 1px solid var(--sundrop-color-border-default);
    background-color: transparent;
    cursor: pointer;
    color: var(--sundrop-color-fg-muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .sundrop-sidebar-toggle:hover {
    color: var(--sundrop-color-fg-default);
    background-color: var(--sundrop-color-border-default);
  }
}
</style>