---
// src/components/Sidebar/DefaultSidebarHeader.astro
import SidebarHeaderItem from './SidebarHeaderItem.astro';
const path = Astro.url.pathname;
let label = path.startsWith('/tools') ? "Tools" : "Blog";
if (path.startsWith('/lab')) label = "Lab";
if (path === '/') label = "Home";
---

  <SidebarHeaderItem icon="lucide:quote" label="Home">
    <span class="brand-title">{label}</span>
  </SidebarHeaderItem>