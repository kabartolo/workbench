---
// src/components/Card.astro
interface Props {
  title: string;
  description?: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} class="sundrop-card">
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    {description && <p class="card-description">{description}</p>}
  </div>
</a>

<style>
@layer sundrop-components {
  .sundrop-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sundrop-color-border-default);
    border-radius: 8px;
    text-decoration: none;
    color: var(--sundrop-color-fg-default);
    background-color: var(--sundrop-color-canvas-subtle);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  a.sundrop-card:hover {
    border-color: var(--sundrop-color-fg-muted);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    text-decoration: none !important;
  }

  .card-body {
    padding: var(--sundrop-scale-4);
    display: flex;
    flex-direction: column;
    gap: var(--sundrop-scale-2);
    flex: 1;
  }

  .card-title {
    font-size: var(--sundrop-size-h5);
    font-weight: 600;
    margin: 0;
    color: var(--sundrop-color-fg-default);
  }

  .card-description {
    font-size: var(--sundrop-size-small);
    color: var(--sundrop-color-fg-muted);
    margin: 0;
    line-height: 1.5;
  }
}
</style>