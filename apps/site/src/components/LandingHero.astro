---
// src/components/LandingHero.astro
interface LinkButton {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

interface Props {
  title: string;
  description: string;
  buttons?: LinkButton[];
}

// TODO: Create LinkButton component

const { title, description, buttons = [] } = Astro.props;
---

<div class="sundrop-landing-hero">
  <h1 class="hero-title">{title}</h1>
  <p class="hero-description">{description}</p>
  {buttons.length > 0 && (
    <div class="hero-buttons">
      {buttons.map(btn => (
        <a href={btn.href} class:list={['hero-button', btn.variant ?? 'secondary']}>
          {btn.label}
        </a>
      ))}
    </div>
  )}
</div>

<style>
@layer sundrop-components {
  .sundrop-landing-hero {
    padding: var(--sundrop-space-2xl) 0 var(--sundrop-space-xl);
    max-width: 640px;
  }

  .hero-title {
    font-size: var(--sundrop-size-h1);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
    margin: 0 0 var(--sundrop-scale-4) 0;
    color: var(--sundrop-color-fg-default);
  }

  .hero-description {
    font-size: var(--sundrop-size-h5);
    color: var(--sundrop-color-fg-muted);
    line-height: 1.6;
    margin: 0 0 var(--sundrop-scale-5) 0;
  }

  .hero-buttons {
    display: flex;
    gap: var(--sundrop-scale-3);
    flex-wrap: wrap;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    padding: var(--sundrop-scale-2) var(--sundrop-scale-4);
    border-radius: 6px;
    font-size: var(--sundrop-size-body);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  a.hero-button.primary {
    background-color: var(--sundrop-color-fg-default);
    color: var(--sundrop-color-canvas-default) !important;
    border: 1px solid var(--sundrop-color-fg-default);
  }

  .hero-button.primary:hover {
    background-color: var(--sundrop-color-fg-muted);
    border-color: var(--sundrop-color-fg-muted);
  }

  .hero-button.secondary {
    background-color: transparent;
    color: var(--sundrop-color-fg-default);
    border: 1px solid var(--sundrop-color-border-default);
  }

  .hero-button.secondary:hover {
    background-color: var(--sundrop-color-canvas-subtle);
    border-color: var(--sundrop-color-fg-muted);
  }
}
</style>