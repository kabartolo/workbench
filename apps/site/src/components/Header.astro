---
// src/components/Header.astro
import { Icon } from './jsx/Icon.jsx';
import { SITE_TITLE, NAV } from '../consts.js';
import HeaderLink from './HeaderLink.astro';
---

<header class="sundrop-header">
  <div class="sundrop-header-left">
    <a href="/" class="sundrop-header-brand">{SITE_TITLE}</a>

    <div class="sundrop-header-nav">
      {NAV.length > 0 && NAV.map((item) => (
        <HeaderLink href={item.link}>{item.label}</HeaderLink>
      ))}
    </div>
  </div>
  <div class="sundrop-header-actions">
    <button id="theme-toggle" class="sundrop-theme-toggle" aria-label="Toggle dark mode" type="button">
      <span class="theme-icon-light"><Icon name="lucide:sun" size="1rem" /></span>
      <span class="theme-icon-dark"><Icon name="lucide:moon" size="1rem" /></span>
    </button>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle');

  toggleBtn?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    localStorage.setItem('sundrop-theme', nextTheme);
  });
</script>

<style>
@layer sundrop-widgets {
  .sundrop-header {
    display: flex;
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 1000;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    padding: 0 var(--sundrop-scale-5);
    border-bottom: 1px solid var(--sundrop-color-border-default);
    background-color: var(--sundrop-color-canvas-default);
    box-sizing: border-box;
  }

  .sundrop-header-left {
    display: flex;
    align-items: center;
    gap: var(--sundrop-scale-5);
  }

  .sundrop-header-nav {
    display: flex;
    align-items: center;
    gap: var(--sundrop-scale-3);
  }

  .sundrop-header-brand {
    font-weight: normal;
    font-size: var(--sundrop-size-h4);
    text-decoration: none;
    color: var(--sundrop-color-fg-default);
  }

  .sundrop-theme-toggle {
    background: transparent;
    border: 1px solid var(--sundrop-color-border-default);
    padding: var(--sundrop-scale-1) var(--sundrop-scale-2);
    border-radius: var(--sundrop-radius-component, 6px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sundrop-color-fg-muted);
  }

  .sundrop-theme-toggle:hover {
    background-color: var(--sundrop-color-canvas-subtle);
    border-color: var(--sundrop-color-fg-accent);
  }

  /* Light mode: show sun, hide moon */
  :root[data-theme="light"] .theme-icon-dark { display: none; }
  :root[data-theme="dark"] .theme-icon-light { display: none; }
}
</style>