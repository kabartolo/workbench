---
import type { MarkdownHeading } from 'astro';
import ScrollArea from "./ScrollArea.astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<ScrollArea>
{filtered.length > 0 && (
  <nav class="sundrop-toc" aria-label="Table of contents">
    <p class="toc-title sidebar-text">On this page</p>
    <ul class="toc-list">
      {filtered.map(heading => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc-link" data-heading={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
</ScrollArea>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const headingIds = Array.from(links).map(l => l.dataset.heading!);
  const headingEls = headingIds
    .map(id => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];

  let current = '';

  const observer = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          current = entry.target.id;
        }
      }
      links.forEach(link => {
        link.classList.toggle('active', link.dataset.heading === current);
      });
    },
    {
      rootMargin: '0px 0px -80% 0px',
      threshold: 1,
    }
  );

  headingEls.forEach(el => observer.observe(el));
</script>

<style>
@layer sundrop-components {
  .sundrop-toc {
    padding: var(--sundrop-scale-4);
    font-size: var(--sundrop-size-small);
  }

  .toc-title {
    font-size: var(--sundrop-size-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sundrop-color-fg-muted);
    margin: 0 0 var(--sundrop-scale-3) 0;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-item.toc-depth-3 {
    padding-left: var(--sundrop-scale-3);
  }

  .toc-link {
    display: block;
    padding: var(--sundrop-scale-1) var(--sundrop-scale-2);
    border-radius: 6px;
    border-left: 2px solid transparent;
    text-decoration: none;
    color: var(--sundrop-color-fg-muted);
    line-height: 1.4;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--sundrop-color-fg-default);
    background-color: var(--sundrop-color-border-default);
  }

  .toc-link.active {
    color: var(--sundrop-color-fg-accent);
    /* border-left-color: var(--sundrop-color-fg-accent-cool); */
    background-color: var(--sundrop-color-surface-cool);
  }
}
</style>