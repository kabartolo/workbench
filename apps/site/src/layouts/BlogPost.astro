---
import Default from './Default.astro';
import Sidebar from "../components/Sidebar/Sidebar.astro";
import Content from "../components/Content.astro";
import type { SidebarEntry } from "../components/Sidebar/Sidebar.astro";
import type { MarkdownHeading } from 'astro';
import TableOfContents from "../components/TableOfContents.astro";

export type PageRef = { label: string; path: string; };

export interface Props {
  title: string;
  description?: string;
  author?: string;
  sidebar?: SidebarEntry[];
  prev?: PageRef;
  next?: PageRef;
  headings?: MarkdownHeading[];
}
const { title, sidebar, description, prev, next, headings } = Astro.props;
---

<Default title={title} description={description} sidebarCollapseMode="hidden">
  {sidebar && sidebar.length > 0 && <Sidebar slot="sidebar-main" sidebar={sidebar} />}

  <Content slot="content" title={title} description={description} next={next} prev={prev}>
    <slot />
  </Content>

  {headings && headings.length > 0 && <TableOfContents slot="right-sidebar" headings={headings} />}
</Default>