---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "../components/BaseHead.astro";
import SidebarHeader from "../components/Sidebar/SidebarHeader.astro";
import DefaultSidebarHeader from "../components/Sidebar/DefaultSidebarHeader.astro";
import DefaultSidebarFooter from "../components/Sidebar/SidebarFooter.astro";
import SidebarPanel from "../components/Sidebar/SidebarPanel.astro";
import SidebarPanelToggle from "../components/Sidebar/SidebarPanelToggle.astro";

export interface Props {
  title: string;
  description?: string;
  sidebarCollapseMode?: 'hidden' | 'icons';
}

const { title, description = '', sidebarCollapseMode = 'hidden' } = Astro.props;
---

<html lang="en" data-theme="light">
<head>
  <BaseHead title={title} description={description} />
</head>
<body>
  <Header />

  <div class="sundrop-shell" data-collapse-mode={sidebarCollapseMode}>
  <SidebarPanel class="panel-left" collapseMode={sidebarCollapseMode}>
    <div class="panel-left-header">
      <SidebarHeader>
      {Astro.slots.has('sidebar-header') ? (
        <slot name="sidebar-header" />
      ) : (
        <DefaultSidebarHeader />
      )}
      </SidebarHeader>
    </div>

    <div class="panel-left-main">
      <slot name="sidebar-main" />
    </div>

    <div class="panel-left-footer">
      {Astro.slots.has('sidebar-footer') ? (
        <slot name="sidebar-footer" />
      ) : (
        <DefaultSidebarFooter />
      )}
    </div>
  </SidebarPanel>

    <main>
       <div class="docs-topbar">
        <SidebarPanelToggle />
      </div>
      <slot name="content" />
    </main>

    <aside class="panel-right">
      <slot name="right-sidebar" />
    </aside>
  </div>

  <Footer />
</body>
</html>

<style>
  body {
    margin: 0;
    font-family: var(--sundrop-font-sans);
    font-size: var(--sundrop-size-body);
    background-color: var(--sundrop-color-canvas-default);
    color: var(--sundrop-color-fg-default);
  }

  .sundrop-shell {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    min-height: 100vh;
    width: 100%;
    transition: grid-template-columns 0.2s ease;
    align-items: start;
  }

  .sundrop-shell[data-sidebar-collapsed="true"] {
    grid-template-columns: 2.5rem 1fr 280px;
  }

  .sundrop-shell > main {
    grid-column: 2;
    padding: 0 10px;
    min-width: 0;
  }

  .docs-topbar {
    display: flex;
    position: fixed;
    top: 64px;
    align-items: center;
    padding: var(--sundrop-scale-3) 0;
    height: 56px;
    box-sizing: border-box;
  }

  :global(.panel-left) {
    grid-column: 1;
    max-width: 280px;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow: hidden;
    background-color: var(--sundrop-color-canvas-subtle);
    border-right: 1px solid var(--sundrop-color-border-default);
    display: flex;
    flex-direction: column;
  }

  .panel-left-header {
    flex-shrink: 0;
    min-height: 48px;
    max-height: 80px;
  }

  .panel-left-main {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  .panel-left-footer {
    flex-shrink: 0;
    min-height: 48px;
    max-height: 80px;
  }

  :global(.panel-right) {
    grid-column: 3;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    background-color: var(--sundrop-color-canvas-subtle);
    border-left: 1px solid var(--sundrop-color-border-default);
    padding: var(--sundrop-scale-4);
  }

  .sundrop-shell[data-sidebar-collapsed="true"][data-collapse-mode="hidden"] {
    grid-template-columns: 0 1fr 280px;
  }

  @media (max-width: 1024px) {
    .sundrop-shell {
      display: flex;
      flex-direction: column;
    }

    :global(.panel-left),
    .panel-right {
      position: static;
      height: auto;
      width: 100%;
      max-width: 100%;
      border: none;
      overflow: visible;
    }
  }
</style>