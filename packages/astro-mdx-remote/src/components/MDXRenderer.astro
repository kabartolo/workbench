---
import * as virtualModule from 'virtual:mdx-components';
import { renderIsland } from '../renderer.js';
import { compileMdx } from '../compiler.js';

const { content, compiledContent } = Astro.props;

// Unwrap the default export from the virtual module
const userComponents = virtualModule.default || virtualModule;

const pageComponents: Record<string, any> = {};

Object.entries(userComponents || {}).forEach(([name, entry]: [string, any]) => {
  const Component = entry.Component || entry;
  const transform = entry.transform;

  pageComponents[name] = (props: any) => {
    const finalizedProps = transform ? transform(props) : props;
    return renderIsland(name, Component, finalizedProps);
  };
});

const MDXContent = compiledContent || await compileMdx(content);
---
<MDXContent components={pageComponents} />

<script>
  import { hydrateIslands } from "../hydrator";
  hydrateIslands();
</script>