{
  "name": "astro-mdx-remote",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./src/components/*"
  },
    "files": [
    "dist",
    "src/components"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc --options typedoc.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsup",
    "release": "pnpm build && changeset publish",
    "dev": "astro dev --root test-site"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^5.0.7",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "7.1.3",
    "prettier": "3.9.4",
    "react-refresh": "^0.18.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3"
  }
}
